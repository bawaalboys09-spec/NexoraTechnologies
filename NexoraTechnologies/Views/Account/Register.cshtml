@model RegisterViewModel
@{
    ViewData["Title"] = "Client registration";
}
<section class="section auth-section"><div class="auth-card"><div class="eyebrow">CLIENT ACCESS</div><h1>Create your account</h1><p class="muted">Register to access your Nexora client portal.</p><form asp-action="Register" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-field"><label asp-for="FullName"></label><input asp-for="FullName" autocomplete="name" /><span asp-validation-for="FullName"></span></div><div class="form-field"><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email"></span></div><div class="form-field"><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password"></span></div><div class="form-field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div><button class="button button-primary button-wide" type="submit">Create account</button></form><p class="auth-bottom">Already have an account? <a asp-action="Login">Sign in</a></p></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
