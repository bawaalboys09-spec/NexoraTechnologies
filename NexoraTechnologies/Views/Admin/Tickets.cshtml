@model IEnumerable<SupportTicket>
@{
    ViewData["Title"] = "Support Tickets";
}
<section class="dashboard-shell"><div class="container py-5"><div class="dashboard-heading"><div><span class="eyebrow dark-eyebrow">Client support</span><h1>Support tickets</h1><p class="text-secondary">Requests submitted through the client portal.</p></div><a class="btn btn-outline-primary" asp-controller="Admin" asp-action="Dashboard">Back to dashboard</a></div><div class="table-card mt-4"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Subject</th><th>Client</th><th>Description</th><th>Status</th><th>Created</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td><strong>@item.Subject</strong></td><td>@(item.Client?.FullName ?? item.Client?.Email ?? item.ClientId)</td><td>@item.Description</td><td><span class="status-pill">@item.Status</span></td><td>@item.CreatedAtUtc.ToString("dd MMM yyyy HH:mm")</td></tr> }
@if (!Model.Any()) { <tr><td colspan="5" class="text-center py-5 text-secondary">No support tickets yet.</td></tr> }
</tbody></table></div></div></div></section>
