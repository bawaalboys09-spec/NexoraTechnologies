@model IReadOnlyList<ContactEnquiry>
@{
    ViewData["Title"] = "Manage Enquiries";
}
<section class="dashboard-section"><div class="container"><div class="dashboard-heading"><div><div class="eyebrow">LEAD MANAGEMENT</div><h1>Project enquiries</h1><p class="muted">Review each enquiry and update its status.</p></div><a class="button button-ghost" asp-action="Index">← Dashboard</a></div>
<div class="table-card"><div class="table-heading"><h2>All enquiries</h2><form method="get" class="filter-form"><label for="status">Filter</label><select id="status" name="status" onchange="this.form.submit()"><option value="">All statuses</option>@foreach (var s in new[] { "New", "Contacted", "Qualified", "Closed", "Spam" }) { <option selected="@(ViewBag.CurrentStatus as string == s)" value="@s">@s</option> }</select></form></div><div class="table-scroll"><table><thead><tr><th>Contact</th><th>Project</th><th>Received</th><th>Status</th><th>Update</th></tr></thead><tbody>
@if (!Model.Any()) { <tr><td colspan="5" class="empty-state">No enquiries match this filter.</td></tr> }
@foreach (var item in Model) { <tr><td><strong>@item.Name</strong><small>@item.Email</small><small>@item.Phone</small><small>@item.Company</small></td><td><strong>@item.Service</strong><small>Budget: @(item.BudgetRange ?? "Not specified")</small><small>Timeline: @(item.Timeline ?? "Not specified")</small><p class="message-preview">@item.Message</p></td><td>@item.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td><td><span class="status-pill status-@item.Status.ToLowerInvariant()">@item.Status</span></td><td><form asp-action="UpdateEnquiryStatus" method="post" class="status-update-form"><input type="hidden" name="id" value="@item.Id" /><select name="status" aria-label="New status for @item.Name">@foreach (var s in new[] { "New", "Contacted", "Qualified", "Closed", "Spam" }) { <option selected="@(item.Status == s)" value="@s">@s</option> }</select><button class="button button-primary button-small" type="submit">Save</button></form></td></tr> }
</tbody></table></div></div></div></section>
