@model IEnumerable<ClientProject>
@{
    ViewData["Title"] = "Client Projects";
}
<section class="dashboard-shell"><div class="container py-5"><div class="dashboard-heading"><div><span class="eyebrow dark-eyebrow">Delivery</span><h1>Client projects</h1><p class="text-secondary">Projects currently recorded in the portal.</p></div><a class="btn btn-outline-primary" asp-controller="Admin" asp-action="Dashboard">Back to dashboard</a></div><div class="table-card mt-4"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Project</th><th>Client</th><th>Status</th><th>Target date</th><th>Created</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td><strong>@item.Title</strong><div class="small text-secondary">@item.Description</div></td><td>@(item.Client?.FullName ?? item.Client?.Email ?? item.ClientId)</td><td><span class="status-pill">@item.Status</span></td><td>@(item.TargetDate?.ToString("dd MMM yyyy") ?? "—")</td><td>@item.CreatedAtUtc.ToString("dd MMM yyyy")</td></tr> }
@if (!Model.Any()) { <tr><td colspan="5" class="text-center py-5 text-secondary">No client projects have been added yet. Project creation UI is a planned next step.</td></tr> }
</tbody></table></div></div></div></section>
