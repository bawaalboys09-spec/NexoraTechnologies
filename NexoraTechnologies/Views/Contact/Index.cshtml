@model ContactViewModel
@{
    ViewData["Title"] = "Contact";
    ViewData["MetaDescription"] = "Contact Nexora Technologies to discuss your website, software, mobile app, ERP or AI project.";
}
<section class="page-hero"><div class="container"><div class="eyebrow">LET'S TALK</div><h1>Tell us what you want <span class="text-gradient">to build.</span></h1><p>Share a few details about your project. We'll use them to understand your needs and plan a useful next conversation.</p></div></section>
<section class="section"><div class="container contact-layout">
    <div class="contact-aside"><h2>Start with the outcome.</h2><p>Whether you need a website, a business application or help improving an existing system, a clear first conversation helps us define the right next step.</p><div class="contact-promise"><span>✓</span><div><strong>Clear next steps</strong><p>We aim to respond with a practical path forward.</p></div></div><div class="contact-promise"><span>✓</span><div><strong>Thoughtful scope</strong><p>We focus on what you need, not unnecessary complexity.</p></div></div></div>
    <form asp-action="Index" method="post" class="form-card">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="form-row"><div class="form-field"><label asp-for="Name"></label><input asp-for="Name" autocomplete="name" placeholder="Your full name" /><span asp-validation-for="Name"></span></div><div class="form-field"><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" placeholder="you@company.com" /><span asp-validation-for="Email"></span></div></div>
        <div class="form-row"><div class="form-field"><label asp-for="Phone"></label><input asp-for="Phone" autocomplete="tel" placeholder="Phone (optional)" /><span asp-validation-for="Phone"></span></div><div class="form-field"><label asp-for="Company"></label><input asp-for="Company" autocomplete="organization" placeholder="Company (optional)" /><span asp-validation-for="Company"></span></div></div>
        <div class="form-row"><div class="form-field"><label asp-for="Service"></label><select asp-for="Service"><option value="">Choose a service</option><option>Website Development</option><option>Software Development</option><option>Mobile App Development</option><option>ERP Solutions</option><option>AI &amp; Automation</option><option>IT Support &amp; Maintenance</option><option>Other</option></select><span asp-validation-for="Service"></span></div><div class="form-field"><label asp-for="BudgetRange"></label><select asp-for="BudgetRange"><option value="">Choose a range (optional)</option><option>Under ₹25,000</option><option>₹25,000–₹75,000</option><option>₹75,000–₹2,00,000</option><option>₹2,00,000+</option><option>Not sure</option></select><span asp-validation-for="BudgetRange"></span></div></div>
        <div class="form-field"><label asp-for="Timeline"></label><select asp-for="Timeline"><option value="">Choose a timeline (optional)</option><option>ASAP</option><option>2–4 weeks</option><option>1–3 months</option><option>Flexible</option></select><span asp-validation-for="Timeline"></span></div>
        <div class="form-field"><label asp-for="Message">Project details</label><textarea asp-for="Message" rows="5" placeholder="What are you trying to achieve? Include useful details, but do not share passwords or sensitive data."></textarea><span asp-validation-for="Message"></span></div>
        <label class="check-field"><input asp-for="Consent" /><span>I agree to be contacted about this enquiry and have read the <a asp-controller="Home" asp-action="Privacy">privacy notice</a>.</span></label><span asp-validation-for="Consent"></span>
        <button type="submit" class="button button-primary button-wide">Send project enquiry ↗</button>
        <p class="form-footnote">Your details are used to respond to this enquiry. Please review the final privacy notice before launch.</p>
    </form>
</div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
