
@model IEnumerable<NexoraTechnologies.Models.ClientProject>

@using NexoraTechnologies.Models

@{
    ViewData["Title"] = "Client Portal";
    var projects = Model ?? Enumerable.Empty<ClientProject>();
    var tickets = ViewBag.Tickets as IEnumerable<SupportTicket>
                  ?? Enumerable.Empty<SupportTicket>();
}

<section class="dashboard-shell">
    <div class="container py-5">

        <div class="dashboard-heading">
            <div>
                <span class="eyebrow dark-eyebrow">Client workspace</span>
                <h1>My project portal</h1>
                <p class="text-secondary">
                    View your projects and support requests.
                </p>
            </div>

            <span class="portal-user">
                <i class="bi bi-person-circle"></i>
                @(User.Identity?.Name ?? "Client")
            </span>
        </div>

        <div class="row g-4 mt-2">

            <div class="col-lg-7">
                <h2 class="subsection-title">My projects</h2>

                @if (projects.Any())
                {
                    foreach (var project in projects)
                    {
                        <article class="project-card mb-3">

                            <div class="d-flex flex-wrap justify-content-between gap-2">
                                <div>
                                    <h3>@project.Title</h3>
                                    <p>@project.Description</p>
                                </div>

                                <span class="status-pill">
                                    @project.Status
                                </span>
                            </div>

                            <div class="small text-secondary">
                                Target date:
                                @(project.TargetDateUtc?.ToString("dd MMM yyyy") ?? "To be confirmed")
                            </div>

                            <div class="mt-3">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span>Project progress</span>
                                    <span>@project.ProgressPercent%</span>
                                </div>

                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar"
                                         role="progressbar"
                                         style="width: @(Math.Clamp(project.ProgressPercent, 0, 100))%;"
                                         aria-valuenow="@project.ProgressPercent"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                    </div>
                                </div>
                            </div>

                        </article>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-kanban"></i>
                        <h3>No projects assigned yet</h3>
                        <p>
                            When Nexora assigns a project to your account,
                            it will appear here.
                        </p>
                    </div>
                }
            </div>

            <div class="col-lg-5">
                <h2 class="subsection-title">Open a support ticket</h2>

                <div class="form-card">
                    <form asp-controller="Client"
                          asp-action="CreateTicket"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label" for="Subject">
                                Subject *
                            </label>

                            <input class="form-control"
                                   id="Subject"
                                   name="Subject"
                                   maxlength="180"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="Description">
                                How can we help? *
                            </label>

                            <textarea class="form-control"
                                      id="Description"
                                      name="Description"
                                      rows="5"
                                      minlength="10"
                                      maxlength="4000"
                                      required></textarea>
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Submit ticket
                        </button>
                    </form>
                </div>

                <h2 class="subsection-title mt-4">
                    My support tickets
                </h2>

                @if (tickets.Any())
                {
                    foreach (var ticket in tickets)
                    {
                        <div class="ticket-mini mb-2">
                            <div class="d-flex justify-content-between gap-2">
                                <strong>@ticket.Subject</strong>
                                <span class="status-pill">
                                    @ticket.Status
                                </span>
                            </div>

                            <small class="text-secondary">
                                @ticket.CreatedAtUtc.ToString("dd MMM yyyy")
                            </small>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <p>No support tickets found.</p>
                    </div>
                }
            </div>

        </div>
    </div>
</section>
